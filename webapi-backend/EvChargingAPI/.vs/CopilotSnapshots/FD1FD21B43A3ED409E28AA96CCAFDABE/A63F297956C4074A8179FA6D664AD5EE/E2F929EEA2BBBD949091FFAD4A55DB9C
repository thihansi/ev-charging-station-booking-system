        [HttpPost("{id}/change-status")]
        [Authorize(Roles = "StationOperator,Backoffice")]
        public async Task<IActionResult> ChangeBookingStatus(Guid id, [FromBody] ChangeBookingStatusDto dto)
        {
            try
            {
                var changedBy = User.FindFirst(ClaimTypes.Name)?.Value ?? "operator";
                var result = await _service.ChangeBookingStatus(id, dto.NewStatus, changedBy, dto.Reason);
                return Ok(new { 
                    Message = $"Booking status changed to {dto.NewStatus} successfully", 
                    Booking = result 
                });
            }
            catch (Exception ex)
            {
                return BadRequest(new { Message = ex.Message });
            }
        }

        [HttpGet("my-bookings/{id}")]
        [Authorize(Roles = "EVOwner")]
        public async Task<IActionResult> GetMyBookingById(Guid id)
        {
            try
            {
                var nic = User.FindFirst("nic")?.Value;
                if (string.IsNullOrEmpty(nic))
                {
                    return Unauthorized("Invalid token");
                }

                // Verify the booking belongs to the authenticated user
                var booking = await _service.GetBookingById(id);
                if (booking.EVOwnerNIC != nic)
                {
                    return Forbid("You can only access your own bookings");
                }

                return Ok(booking);
            }
            catch (Exception ex)
            {
                return NotFound(new { Message = ex.Message });
            }
        }
    }
}