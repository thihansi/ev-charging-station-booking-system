using EVChargingSystem.Api.DTOs;
using EVChargingSystem.Api.Services;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using System.Security.Claims;

namespace EvChargingAPI.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    public class BookingsController : ControllerBase
    {
        private readonly IBookingService _service;

        public BookingsController(IBookingService service)
        {
            _service = service;
        }

        [HttpPost("summary")]
        [Authorize(Roles = "EVOwner")]
        public async Task<IActionResult> GetBookingSummary([FromBody] BookingDto dto)
        {
            try
            {
                var nic = User.FindFirst("nic")?.Value;
                if (string.IsNullOrEmpty(nic))
                {
                    return Unauthorized("Invalid token");
                }

                dto.EVOwnerNIC = nic;
                var summary = await _service.GetBookingSummary(dto);
                return Ok(summary);
            }
            catch (Exception ex)
            {
                return BadRequest(new { Message = ex.Message });
            }
        }

        [HttpPost]
        [Authorize(Roles = "EVOwner")]
        public async Task<IActionResult> CreateBooking([FromBody] BookingDto dto)
        {
            try
            {
                // Get NIC from JWT token
                var nic = User.FindFirst("nic")?.Value;
                if (string.IsNullOrEmpty(nic))
                {
                    return Unauthorized("Invalid token");
                }

                // Ensure the booking is for the authenticated user
                dto.EVOwnerNIC = nic;

                var result = await _service.CreateBooking(dto);
                return Ok(new { Message = "Booking created successfully. Awaiting approval.", Booking = result });
            }
            catch (Exception ex)
            {
                return BadRequest(new { Message = ex.Message });
            }
        }

        [HttpPut("{id}")]
        [Authorize(Roles = "EVOwner")]
        public async Task<IActionResult> UpdateBooking(Guid id, [FromBody] BookingDto dto)
        {
            try
            {
                // Get NIC from JWT token
                var nic = User.FindFirst("nic")?.Value;
                if (string.IsNullOrEmpty(nic))
                {
                    return Unauthorized("Invalid token");
                }

                // Verify the booking belongs to the authenticated user
                var existingBooking = await _service.GetBookingById(id);
                if (existingBooking.EVOwnerNIC != nic)
                {
                    return Forbid("You can only update your own bookings");
                }

                dto.EVOwnerNIC = nic;
                var result = await _service.UpdateBooking(id, dto);
                return Ok(new { Message = "Booking updated successfully", Booking = result });
            }
            catch (Exception ex)
            {
                return BadRequest(new { Message = ex.Message });
            }
        }

        [HttpDelete("{id}")]
        [Authorize(Roles = "EVOwner")]
        public async Task<IActionResult> CancelBooking(Guid id)
        {
            try
            {
                // Get NIC from JWT token
                var nic = User.FindFirst("nic")?.Value;
                if (string.IsNullOrEmpty(nic))
                {
                    return Unauthorized("Invalid token");
                }

                // Verify the booking belongs to the authenticated user
                var existingBooking = await _service.GetBookingById(id);
                if (existingBooking.EVOwnerNIC != nic)
                {
                    return Forbid("You can only cancel your own bookings");
                }

                await _service.CancelBooking(id);
                return Ok(new { Message = "Booking cancelled successfully" });
            }
            catch (Exception ex)
            {
                return BadRequest(new { Message = ex.Message });
            }
        }

        [HttpGet("my-bookings")]
        [Authorize(Roles = "EVOwner")]
        public async Task<IActionResult> GetMyBookings()
        {
            try
